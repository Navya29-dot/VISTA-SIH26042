# The default database is the local data/vista.db SQLite file.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Set this to the confirmed, downloaded distilled IndicTrans2 checkpoint.
INDICTRANS2_MODEL_NAME=D:\AIModels\indictrans2-distilled
INDICTRANS2_ONNX_PATH=D:\AIModels\indictrans2-distilled-int8
INDICTRANS2_CACHE_DIR=D:\AIModels\cache
INDICTRANS2_LOCAL_FILES_ONLY=true
INDICTRANS2_DEVICE=cpu
PHRASE_BANK_PATH=D:\AIModels\vista-phrase-bank.json
VOSK_MODEL_PATH=D:\AIModels\vosk-model-small-hi-0.22
VOSK_ENGLISH_MODEL_PATH=D:\AIModels\vosk-model-small-en-us-0.15
VOSK_SAMPLE_RATE=16000
